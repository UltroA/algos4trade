# Copy this file to .env and fill in your own values. .env is gitignored -
# never commit it, and never paste its contents into an issue, PR, or log
# (see SECURITY.md).

# Required. A T-Invest API (T-Bank Investments) token - read-only is enough,
# trading permissions are not required for downloading historical candles.
T_INVEST_TOKEN=

# Optional, only needed for the news-sentiment pipeline (scripts/run_news_monitor.py,
# algorithms/news_sentiment.py / news_sentiment_memory.py). Requires a local
# LM Studio server with a model loaded (LM Studio -> Developer tab -> start server).
LMSTUDIO_MODEL=
# Default shown below; only needed if LM Studio runs somewhere other than localhost.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
